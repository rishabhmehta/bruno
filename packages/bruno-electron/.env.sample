BRUNO_INFO_ENDPOINT = http://localhost:8081
DISABLE_SAMPLE_COLLECTION_IMPORT = false

# ---------------------------------------------------------------------------
# macOS signing and notarization (optional)
#
# Copy this file to `.env` in this folder (packages/bruno-electron/.env, already
# gitignored) and fill in the values of the developer who signs the build.
# Leave APPLE_SIGNING_IDENTITY empty to build an unsigned app for local testing.
# Full steps: .claude/build.md
# ---------------------------------------------------------------------------

# Exactly as shown by `security find-identity -v -p codesigning`, without the
# "Developer ID Application: " prefix. Example: Jane Doe (ABCDE12345)
APPLE_SIGNING_IDENTITY =

# The Apple ID email of the same developer account
APPLE_ID =

# App-specific password from https://account.apple.com (Sign-In and Security)
# Not the normal Apple ID password.
APPLE_APP_SPECIFIC_PASSWORD =

# 10-character Team ID; must match the one in APPLE_SIGNING_IDENTITY
APPLE_TEAM_ID =

# true = sign but skip notarization (local testing only; macOS blocks the app when downloaded)
SKIP_NOTARIZE = false

# true = also build a signed .pkg installer (needs a "Developer ID Installer" certificate too)
MAC_BUILD_PKG = false

# Bundle ID of the app. Defaults to the official Bruno one (com.usebruno.app).
# A fork distributed to others should use its own, e.g. com.yourname.bruno
BRUNO_APP_ID =
